{
  "name": "masr-live",
  "productName": "Masr Live",
  "version": "1.0.0",
  "description": "مصر لايف - إذاعات وقنوات بث مباشر",
  "main": "main.js",
  "author": "AWAD",
  "scripts": { "dist": "electron-builder --win nsis --x64 --publish never" },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" },
  "build": {
    "appId": "net.masrlive.desktop",
    "productName": "مصر لايف",
    "artifactName": "MasrLive-Setup.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "مصر لايف", "language": "1025" }
  }
}
